<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gaoshuang.mapper.EmpMapper">
    <!--更新员工信息-->

    <update id="upDateById" parameterType="com.gaoshuang.pojo.Emp">
        UPDATE emp
        <set>
            <!-- 基础信息 -->
            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="gender != null">
                gender = #{gender},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>

            <!-- 职位与薪资 -->
            <if test="job != null">
                job = #{job},
            </if>
            <if test="salary != null">
                salary = #{salary},
            </if>

            <!-- 其他信息 -->
            <if test="image != null">
                image = #{image},
            </if>
            <if test="entryDate != null">
                entry_date = #{entryDate},
            </if>
            <if test="deptId != null">
                dept_id = #{deptId},
            </if>

            <!-- 自动维护更新时间 -->
            <if test="updateTime != null">update_time = #{updateTime}</if>
        </set>
        WHERE id = #{id}
    </update>

    <!--批量删除员工信息-->
    <delete id="deleteByIds">
        delete from emp where id in <foreach collection="ids" item="id" separator="," open="(" close=")">
        #{id}
    </foreach>
    </delete>

    <select id="list" resultType="com.gaoshuang.pojo.Emp">
        select e.*, d.name deptname from emp e left join dept d on e.dept_id = d.id
        <where>
            <if test="name != null and name!=''">
                e.name like concat('%',#{name},'%')
            </if>
        <if test="gender != null">
                and e.gender = #{gender}
        </if>
        <if test="begin != null and end != null ">
          and e.entry_date between #{begin}
              and #{end}
        </if>
        </where>order by e.update_time desc
    </select>

    <!--定义empResulMap-->
    <resultMap id="empResulMap" type="com.gaoshuang.pojo.Emp">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="name" property="name"/>
        <result column="gender" property="gender"/>
        <result column="job" property="job"/>
        <result column="phone" property="phone"/>
        <result column="salary" property="salary"/>
        <result column="image" property="image"/>
        <result column="entry_date" property="entryDate"/>
        <result column="dept_id" property="deptId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <!--封装工作信息-->
        <collection property="exprList" ofType="com.gaoshuang.pojo.EmpExpr">
            <id column="ee_id" property="id"/>
            <result column="ee_empid" property="empId"/>
            <result column="ee_eebegin" property="begin"/>
            <result column="ee_begin" property="end"/>
            <result column="ee_company" property="company"/>
            <result column="ee_job" property="job"/>
        </collection>



    </resultMap>
    <!--根据id查询员工信息和工作经历-->
    <select id="getById" resultMap="empResulMap">
        select e.*,ee.id ee_id,
               ee.emp_id ee_empid,
               ee.begin ee_eebegin,
               ee.end ee_begin,
               ee.company ee_company,
               ee.job ee_job
        from emp e left join emp_expr ee on e.id = ee.emp_id
        where e.id = #{id};
    </select>
<!--    统计职位员工人数-->
    <select id="countEmpJobDate">
        select (case job when 1 then '班主任'
                         when 2 then '讲师'
                         when 3 then '学工主管'
                         when 4 then '教研主管'
                         when 5 then '咨询师' end) pos ,
               count(*) num from emp group by job order by num;
    </select>
    <!--    统计员工性别人数-->
    <select id="countEmpGenderDate" resultType="java.util.Map">
        select if(gender =1 , '男性员工' , '女性员工' ) name ,count(*) value
        from emp group by  gender order by value;
    </select>
    <select id="getEducationData" resultType="java.util.Map">
        select (case degree when 1 then '初中'
                               when 6 then '博士'
                               when 2 then '高中'
                               when 3 then '大专'
                               when 4 then '本科'
                               when 5 then '硕士'

            end) name ,
               count(*) value
        from student group by degree order by value;
    </select>
    <select id="getStudentCountData" resultType="java.util.Map">
        select c.name, count(s.id) as num from clazz c left join student s on c.id = s.clazz_id group by c.id;
    </select>
</mapper>